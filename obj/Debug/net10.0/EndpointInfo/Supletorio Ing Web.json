{
  "openapi": "3.1.1",
  "info": {
    "title": "Supletorio Ing Web | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7174"
    },
    {
      "url": "http://localhost:5279"
    }
  ],
  "paths": {
    "/api/Productos": {
      "post": {
        "tags": [
          "Productos"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductoDTO"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductoDTO"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ProductoDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Productos"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Productos/{id}": {
      "get": {
        "tags": [
          "Productos"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductoDTO": {
        "required": [
          "nombre",
          "precio",
          "stock",
          "descuento"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "precio": {
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          },
          "stock": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "descuento": {
            "maximum": 1,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Productos"
    }
  ]
}